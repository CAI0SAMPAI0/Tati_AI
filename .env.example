# ==============================================================================
# TEACHER TATI AI - EXEMPLO DE VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================
# Use este arquivo como modelo para configurar seu ambiente local ou na nuvem.
# Copie este arquivo para .env e preencha os valores reais de suas chaves.
# NENHUMA CHAVE REAL OU CREDENCIAL PRIVADA DEVE SER VERSIONADA NESTE ARQUIVO.
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. SERVIDOR & CORE DJANGO
# Configurações fundamentais da aplicação Django, URLs de roteamento e perfis administrativos.
# ------------------------------------------------------------------------------
# Modo debug do Django (False em produção, True apenas em desenvolvimento local)
DEBUG=false

# Porta HTTP em que o servidor web irá escutar
PORT=8080

# Nível de detalhamento dos logs do sistema (INFO, DEBUG, WARNING, ERROR)
LOG_LEVEL=INFO

# URL pública da aplicação frontend Next.js (usada para CORS, redirects e e-mails)
FRONTEND_URL=https://tati-ai.vercel.app

# URL base pública da API Django (usada para webhooks e callbacks)
BACKEND_BASE_URL=https://api.tati-ai.com

# Nome de exibição da assistente pedagógica virtual
PROFESSOR_NAME=Teacher Tati

# Lista separada por vírgulas de usernames com privilégios técnicos/desenvolvedor
PROGRAMMER_USERNAMES=programador,admin,caio

# Lista separada por vírgulas de usernames de administradores pedagógicos
ADMIN_USERNAMES=programador,admin,professor,professora

# E-mail do desenvolvedor para recebimento de alertas de sistema e relatórios
DEV_NOTIFICATION_EMAIL=dev@tati-ai.com

# Endereço de e-mail remetente padrão para comunicações do sistema
DEFAULT_FROM_EMAIL=Teacher Tati <contato@tati-ai.com>


# ------------------------------------------------------------------------------
# 2. AUTENTICAÇÃO & SEGURANÇA
# Chaves criptográficas, assinatura de tokens JWT, proteção de cookies e testes de carga.
# ------------------------------------------------------------------------------
# Chave secreta forte para assinar e validar tokens JWT de autenticação
JWT_SECRET_KEY=sua_chave_secreta_jwt_forte_aqui

# Chave para criptografia e validação de cookies de sessão seguros
COOKIE_SECRET=sua_chave_de_cookie_secreta_aqui

# Chave AES para criptografar dados sensíveis de usuários em repouso
ENCRYPTION_KEY=sua_chave_de_encriptacao_aqui

# Token Bearer exigido para acionar endpoints de tarefas agendadas (Cron jobs)
CRON_TOKEN=seu_token_de_cron_secreto

# Chave de API interna para comunicação entre microserviços e agentes da Tati AI
TATI_AI_KEY=sua_chave_interna_tati_ai

# Usuário de autenticação básica para execução de testes de estresse (Locust)
LOCUST_USER=locust_admin

# Senha para execução de testes de estresse (Locust)
LOCUST_PASSWORD=sua_senha_locust_aqui


# ------------------------------------------------------------------------------
# 3. BANCO DE DADOS (POSTGRESQL / NEON / RAILWAY)
# Strings de conexão e credenciais do banco de dados relacional PostgreSQL.
# ------------------------------------------------------------------------------
# URI de conexão primária com o PostgreSQL (pooler ou conexão direta)
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_banco?sslmode=require

# URI pública alternativa para acesso ao banco via proxy externo
DATABASE_PUBLIC_URL=postgresql://usuario:senha@host-publico:5432/nome_banco?sslmode=require

# Hostname do servidor PostgreSQL
PGHOST=ep-exemplo.sa-east-1.aws.neon.tech

# Porta do servidor PostgreSQL
PGPORT=5432

# Nome do banco de dados PostgreSQL
PGDATABASE=neondb

# Usuário do banco de dados PostgreSQL
PGUSER=seu_usuario_postgres

# Senha do usuário do banco de dados PostgreSQL
PGPASSWORD=sua_senha_postgres_aqui

# Caminho do diretório de dados em containers locais do PostgreSQL
PGDATA=/var/lib/postgresql/data

# Nome do banco em inicialização de containers Docker
POSTGRES_DB=tati_ai_db

# Usuário padrão em inicialização de containers Docker
POSTGRES_USER=postgres

# Senha padrão em inicialização de containers Docker
POSTGRES_PASSWORD=sua_senha_docker_postgres

# Tempo máximo em segundos de reutilização de conexões SQL no Django (60-600)
DB_CONN_MAX_AGE=600

# Dias de validade do certificado SSL
SSL_CERT_DAYS=820


# ------------------------------------------------------------------------------
# 4. CACHE & RATE LIMITING (REDIS / UPSTASH)
# Cache em memória para sessões, cotas de requisições por IP e aceleração de consultas.
# ------------------------------------------------------------------------------
# URI de conexão completa com o servidor Redis (ex: redis://... ou rediss://...)
REDIS_URL=redis://default:senha@host:6379

# URI pública de conexão com o Redis em instâncias de nuvem
REDIS_PUBLIC_URL=redis://default:senha@host-publico:6379

# Hostname do servidor Redis
REDISHOST=redis.railway.internal

# Porta do servidor Redis
REDISPORT=6379

# Usuário de autenticação Redis (padrão: default)
REDISUSER=default

# Senha de autenticação do servidor Redis
REDISPASSWORD=sua_senha_redis_aqui

# Alias alternativo para senha de autenticação Redis
REDIS_PASSWORD=sua_senha_redis_aqui

# URL da API REST do Upstash Redis (usado para rate limiting serverless)
UPSTASH_REDIS_URL=https://seu-redis.upstash.io

# Token de autenticação REST do Upstash Redis
UPSTASH_REDIS_TOKEN=seu_token_upstash_aqui


# ------------------------------------------------------------------------------
# 5. FILA DE TAREFAS ASSÍNCRONAS & CELERY (RABBITMQ / CLOUDAMQP)
# Processamento assíncrono em segundo plano para envio de e-mails, relatórios e processamento pesado.
# ------------------------------------------------------------------------------
# Ativa o processamento de tarefas em background via Celery (true/false)
USE_CELERY=true

# URL do broker de mensagens para o Celery (CloudAMQP / RabbitMQ ou Redis)
CELERY_BROKER_URL=amqp://usuario:senha@host:5672/vhost

# URI completa de conexão gerenciada CloudAMQP (instância ativa)
CLOUD_AMQP_URL=amqps://usuario:senha@jackal.rmq.cloudamqp.com/vhost

# Chave identificadora ou API key da instância CloudAMQP
CLOUD_AMQP_KEY=sua_chave_cloud_amqp_aqui

# URI de conexão direta com RabbitMQ
RABBITMQ_URL=amqp://usuario:senha@localhost:5672/

# Usuário padrão de inicialização do RabbitMQ
RABBITMQ_DEFAULT_USER=admin

# Senha padrão de inicialização do RabbitMQ
RABBITMQ_DEFAULT_PASS=sua_senha_rabbitmq_aqui

# Identificador do nó RabbitMQ para clusters e containers
RABBITMQ_NODENAME=rabbit@localhost

# Define se a instância atua como worker dedicado para tarefas lentas (true/false)
IS_HEAVY_WORKER=false


# ------------------------------------------------------------------------------
# 6. INTELIGÊNCIA ARTIFICIAL (LLMs, MODELOS & APIS)
# Provedores de inferência de linguagem natural (Groq, Gemini, OpenAI, Hugging Face, Tavily).
# ------------------------------------------------------------------------------
# Modelo de linguagem padrão da Teacher Tati
LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct:novita

# Provedor primário de LLM (groq, gemini, huggingface, openai, meta_llama)
LLM_PROVIDER=groq

# Modelo principal na API Groq para alta velocidade
GROQ_MODEL=llama-3.3-70b-versatile

# Modelo de embedding para busca semântica e RAG pedagógico
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# Habilita cache de respostas idênticas para economizar tokens de IA (true/false)
AI_CACHE_ENABLED=true

# Tempo de retenção em segundos do cache semântico de IA (ex: 86400 = 24h)
AI_CACHE_TTL=86400

# Chave primária da API Groq (inferência rápida em Llama)
GROQ_API_KEY=gsk_sua_chave_groq_primaria

# Chave secundária da API Groq para rotação automática de cota
GROQ_API_KEY_1=gsk_sua_chave_groq_reserva_1

# Chave terciária da API Groq para rotação automática de cota
GROQ_API_KEY_2=gsk_sua_chave_groq_reserva_2

# Chave quaternária da API Groq para rotação automática de cota
GROQ_API_KEY_3=gsk_sua_chave_groq_reserva_3

# Chave de fallback adicional da API Groq
GROQ_API_KEY_4=gsk_sua_chave_groq_reserva_4

# Chave da API Google Gemini para visão multimodal e raciocínio avançado
GEMINI_API_KEY=AIzaSy_sua_chave_gemini_aqui

# Chave da API OpenAI para modelos GPT e transcrições Whisper
OPENAI_API_KEY=sk-proj-sua_chave_openai_aqui

# Token de API do Hugging Face para modelos de linguagem e Spaces
HUGGING_FACE_KEY=hf_seu_token_huggingface_aqui

# Token de autenticação padrão Hugging Face
HF_TOKEN=hf_seu_token_huggingface_aqui

# Token Hugging Face aprovado para download dos modelos oficiais Llama
HF_TOKEN_LLAMA=hf_seu_token_hf_llama_aqui

# Chave primária da API Tavily para pesquisas web em tempo real pelo assistente
TAVILY_API_KEY=tvly-sua_chave_tavily_primaria

# Chave secundária de reserva da API Tavily
TAVILY_API_KEY_1=tvly-sua_chave_tavily_reserva_1

# Chave terciária de reserva da API Tavily
TAVILY_API_KEY_2=tvly-sua_chave_tavily_reserva_2


# ------------------------------------------------------------------------------
# 7. VOZ, ÁUDIO & VÍDEO (TTS, XTTS, ELEVENLABS, SADTALKER)
# Síntese de voz expressiva (ElevenLabs / XTTS) e animação facial realista.
# ------------------------------------------------------------------------------
# ID da voz clonada ou selecionada da Teacher Tati na ElevenLabs
VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Chave primária da ElevenLabs para síntese de voz (TTS) de alta qualidade
ELEVENLABS_API_KEY=sk_sua_chave_elevenlabs_primaria

# Chave de reserva da ElevenLabs para contingência de créditos
ELEVENLABS_API_KEY_2=sk_sua_chave_elevenlabs_reserva_2

# Chave terciária da ElevenLabs
ELEVENLABS_API_KEY_3=sk_sua_chave_elevenlabs_reserva_3

# Endpoint da API XTTS v2 para geração de voz self-hosted (HF Space ou container)
XTTS_API_URL=https://seu-space-xtts.hf.space/tts

# Nome do arquivo de áudio WAV de referência da voz da Tatiana para clonagem
XTTS_SPEAKER_WAV=tatiana.wav

# Idioma da fala gerada via XTTS (ex: en)
XTTS_LANGUAGE=en

# Endpoint do serviço SadTalker para geração de vídeos com sincronização labial
SADTALKER_URL=https://seu-space-sadtalker.hf.space


# ------------------------------------------------------------------------------
# 8. WHATSAPP & WEBHOOKS (WAHA HTTP API)
# Integração com WhatsApp via WAHA (WhatsApp HTTP API) para conversação com alunos.
# ------------------------------------------------------------------------------
# URL base do serviço WAHA (ex: container local ou serviço na Railway)
WAHA_API_URL=http://localhost:3000

# Chave de autenticação Bearer para envio de mensagens via WAHA
WAHA_API_KEY=sua_chave_waha_api_aqui

# Usuário de acesso ao painel de administração web do WAHA
WAHA_DASHBOARD_USERNAME=admin

# Senha de acesso ao painel de administração web do WAHA
WAHA_DASHBOARD_PASSWORD=sua_senha_dashboard_waha

# Chave da API WhatsApp para chamadas legadas/alternativas
WHATSAPP_API_KEY=sua_chave_whatsapp_api

# Tipo de armazenamento de sessão do WAHA (POSTGRESQL para persistência em nuvem)
WHATSAPP_SESSIONS_TYPE=POSTGRESQL

# URL do PostgreSQL para persistência de sessões e QR Codes do WhatsApp
WHATSAPP_SESSIONS_POSTGRESQL_URL=postgresql://usuario:senha@host:5432/waha_sessions

# URL do backend para onde o WAHA despacha as mensagens recebidas dos alunos
FORWARD_WEBHOOK_URL=https://api.tati-ai.com/api/v1/whatsapp/webhook


# ------------------------------------------------------------------------------
# 9. E-MAILS & NOTIFICAÇÕES (SMTP, BREVO, RESEND)
# Envio de e-mails transacionais (boas-vindas, recuperação de senha, lembretes de estudo).
# ------------------------------------------------------------------------------
# Servidor SMTP para envio de e-mails transacionais (ex: smtp-relay.brevo.com)
SMTP_HOST=smtp-relay.brevo.com

# Porta de conexão SMTP (587 para TLS/STARTTLS ou 465 para SSL)
SMTP_PORT=587

# Usuário / login do servidor SMTP
SMTP_USER=seu_email_login_smtp@dominio.com

# Senha do servidor SMTP ou Master Password / API Key
SMTP_PASSWORD=sua_senha_smtp_aqui

# Endereço remetente exibido nos e-mails enviados aos alunos
SMTP_FROM=tatiai@tati-ai.com

# E-mail de destino para recebimento de dúvidas e feedbacks dos alunos
EMAIL_FEEDBACK=contato@tati-ai.com

# Chave de API do serviço Resend (alternativa moderna a SMTP)
RESEND_API_KEY=re_sua_chave_resend_aqui

# Chave de API da plataforma Brevo (antigo Sendinblue) para automações
BREVO_API_KEY=xkeysib-sua_chave_brevo_aqui

# Chave de API Brevo dedicada da Teacher Tati
BREVO_API_KEY_TATY=xkeysib-sua_chave_brevo_taty_aqui

# Alias legado para SMTP_HOST
servidor_smpt=smtp-relay.brevo.com

# Alias legado para SMTP_PORT
port=587

# Alias legado para SMTP_USER
login_smtp=seu_email_login_smtp@dominio.com

# Alias legado para SMTP_PASSWORD
brevo_smtp_key=sua_chave_smtp_brevo_aqui


# ------------------------------------------------------------------------------
# 10. WEB PUSH NOTIFICATIONS (VAPID)
# Notificações push diretamente no navegador e Progressive Web App (PWA) dos alunos.
# ------------------------------------------------------------------------------
# Chave pública VAPID (injetada no service worker do frontend para subscrição)
VAPID_PUBLIC_KEY=sua_chave_publica_vapid_aqui

# Chave privada VAPID (mantida no backend para assinar envios push)
VAPID_PRIVATE_KEY=sua_chave_privada_vapid_aqui

# E-mail de contato do responsável pelas notificações Web Push (mailto:...)
VAPID_CONTACT=mailto:suporte@tati-ai.com


# ------------------------------------------------------------------------------
# 11. MÍDIA, IMAGENS & STORAGE (CLOUDINARY, UNSPLASH, PEXELS)
# Upload de mídias, armazenamento de áudios/fotos e bancos de imagens pedagógicas.
# ------------------------------------------------------------------------------
# Nome do ambiente na Cloudinary para upload e transformação de fotos
CLOUDINARY_CLOUD_NAME=seu_cloud_name

# Chave pública da API Cloudinary
CLOUDINARY_API_KEY=sua_api_key_cloudinary

# Chave secreta privada da API Cloudinary
CLOUDINARY_API_SECRET=seu_api_secret_cloudinary

# URI de conexão completa Cloudinary (formato cloudinary://key:secret@name)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Chave de acesso Unsplash para buscar imagens contextuais de vocabulário
UNSPLASH_ACCESS_KEY=sua_access_key_unsplash

# Chave secreta Unsplash
UNSPLASH_SECRET_KEY=sua_secret_key_unsplash

# Chave da API Pexels para fotos e vídeos de suporte didático
PEXELS_API_KEY=sua_api_key_pexels


# ------------------------------------------------------------------------------
# 12. GOOGLE (OAUTH, DRIVE & IDENTIDADE)
# Autenticação via Google Sign-In e integração com Google Drive para materiais de aula.
# ------------------------------------------------------------------------------
# Client ID OAuth2 para login social com conta Google no frontend e backend
GOOGLE_CLIENT_ID=seu_client_id.apps.googleusercontent.com

# Client ID específico para acesso e sincronização com o Google Drive
GOOGLE_CLIENT_ID_DRIVE=seu_client_id_drive.apps.googleusercontent.com

# Client Secret da aplicação no Google Cloud Console
GOOGLE_CLIENT_SECRET=GOCSPX-seu_client_secret_aqui

# ID do projeto configurado no Google Cloud Console
GOOGLE_PROJECT_ID=tati-ai-production

# ID da pasta raiz no Google Drive contendo áudios e PDFs de aula
GOOGLE_DRIVE_FOLDER_ID=seu_id_de_pasta_no_google_drive

# ID ou caminho do diretório de arquivos pedagógicos da Tatiana no Drive
DRIVE_TATI_FILES=seu_id_drive_tati_files

# URL do endpoint de autorização OAuth2 do Google
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth

# URL do endpoint de troca de tokens OAuth2 do Google
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token


# ------------------------------------------------------------------------------
# 13. PAGAMENTOS (MERCADO PAGO & ASAAS)
# Gateways de pagamento para assinaturas, Pix, boletos e checkout seguro de cursos.
# ------------------------------------------------------------------------------
# Access Token privado do Mercado Pago para criação e consulta de cobranças
MP_ACCESS_TOKEN=APP_USR-seu_access_token_mercado_pago

# Public Key do Mercado Pago utilizada no frontend para tokenizar cartões
MP_PUBLIC_KEY=APP_USR-sua_public_key_mercado_pago

# URL ou chave secreta de validação dos webhooks de pagamento do Mercado Pago
WEBHOOK_MP=https://api.tati-ai.com/api/v1/payments/webhook

# Chave de API do gateway Asaas para faturamento e Pix recorrente
API_ASAAS=$aact_sua_chave_asaas_aqui

# Ambiente de execução Asaas (sandbox para testes, production para real)
ASAAS_ENVIRNMENT=sandbox

# Token de assinatura para autenticar webhooks enviados pelo Asaas
ASAAS_WEBHOOK_TOKEN=whsec_seu_webhook_token_asaas


# ------------------------------------------------------------------------------
# 14. SUPABASE (SERVIÇOS DE SUPORTE)
# Configurações de projetos Supabase utilizados como suporte de banco ou storage.
# ------------------------------------------------------------------------------
# URL base da API do projeto Supabase
SUPABASE_URL=https://seu-projeto.supabase.co

# Chave anônima / pública (anon key) do Supabase
SUPABASE_KEY=sua_chave_anon_supabase

# Chave de serviço (service role) com acesso de superusuário ao Supabase
SUPABASE_SERVICE_KEY=sua_chave_service_role_supabase


# ------------------------------------------------------------------------------
# 15. MONITORAMENTO & OBSERVABILIDADE (SENTRY)
# Rastreamento em tempo real de erros, exceções não tratadas e telemetria de latência.
# ------------------------------------------------------------------------------
# Data Source Name do Sentry para captura de erros no backend Django
SENTRY_DSN=https://sua_chave@o000000.ingest.sentry.io/0000000

# DSN pública do Sentry consumida pelo frontend Next.js
NEXT_PUBLIC_SENTRY_DSN=https://sua_chave_publica@o000000.ingest.sentry.io/0000000

# Ambiente de monitoramento Sentry (production, staging, development)
SENTRY_ENVIRONMENT=production

# Taxa percentual de amostragem de rastreamento de transações (0.0 a 1.0)
SENTRY_TRACES_SAMPLE_RATE=0.2

# Taxa de amostragem de profiling de desempenho em CPU (0.0 a 1.0)
SENTRY_PROFILES_SAMPLE_RATE=0.0


# ------------------------------------------------------------------------------
# 16. SERVERLESS & SCHEDULER (RAILWAY & AUTOMATION)
# Otimizações de infraestrutura para hibernação automática (Serverless) e agendamento de tarefas.
# ------------------------------------------------------------------------------
# Se true, desativa schedulers contínuos permitindo que o container hiberne após 10min de inatividade na Railway
SERVERLESS=false

# Habilita o agendador em background de notificações (iniciado se SERVERLESS=false)
ENABLE_NOTIFICATION_SCHEDULER=true

# Segundos aguardados para drenagem de requisições ativas antes de destruir réplicas antigas
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=10

# Se true, roda o container em modo proxy reverso para roteamento intermediário
RUN_AS_PROXY=false

# Host de destino para onde o proxy deve encaminhar o tráfego quando RUN_AS_PROXY=true
PROXY_TARGET_HOST=localhost

