FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONMALLOC=malloc \
    MALLOC_TRIM_THRESHOLD_=65536 \
    DJANGO_SETTINGS_MODULE=app.settings.production \
    WORKERS=1 \
    DB_CONN_MAX_AGE=0 \
    USE_REDIS_CACHE=false \
    ENABLE_NOTIFICATION_SCHEDULER=false \
    SERVERLESS=true

# Instalar apenas dependências mínimas de sistema (imagem enxuta focada em pagamentos e serverless)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY . /tmp/build/

RUN if [ -f "/tmp/build/backend/requirements.txt" ]; then \
      cp /tmp/build/backend/requirements.txt ./requirements.txt; \
      cp -r /tmp/build/backend/. ./; \
    else \
      cp /tmp/build/requirements.txt ./requirements.txt; \
      cp -r /tmp/build/. ./; \
    fi \
    && rm -rf /tmp/build \
    && pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

# Coleta arquivos estáticos
RUN python manage.py collectstatic --noinput || true

EXPOSE 7860 8080 8000

# Executa Gunicorn com Uvicorn workers suportando $PORT injetada pelo Railway e reciclagem de memória para App-Sleeping.
CMD ["sh", "-c", "BIND_PORT=\"${PORT:-8000}\"; exec gunicorn app.asgi:application -w ${WORKERS:-1} -k uvicorn.workers.UvicornWorker -b 0.0.0.0:${BIND_PORT} --forwarded-allow-ips '*' --timeout 120 --graceful-timeout 15 --keep-alive 2 --max-requests 100 --max-requests-jitter 20 --access-logfile -"]
