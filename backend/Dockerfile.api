# Dockerfile de Produção Otimizado para Railway Serverless (App-Sleeping / Escala a Zero)
# Baseado na estrutura de produção de backend/Dockerfile com ASGI (Gunicorn + Uvicorn Workers).
# Desativa schedulers internos em background e loops de keepalive (ex: WAHA ping) para
# permitir que a instância durma automaticamente após 10 minutos de inatividade sem requisições externas.
FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DJANGO_SETTINGS_MODULE=app.settings.production \
    WORKERS=1 \
    ENABLE_NOTIFICATION_SCHEDULER=false \
    SERVERLESS=true

# Instalar dependências de sistema para compilação e conversão de documentos
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    libpq-dev \
    curl \
    ffmpeg \
    libreoffice \
    poppler-utils \
    && rm -rf /var/lib/apt/lists/*

# Suporte resiliente para build na raiz do monorepo (Railway) ou no subdiretório /backend (Docker Compose / Hugging Face)
COPY . /tmp/build/

RUN if [ -f "/tmp/build/backend/requirements.txt" ]; then \
      cp /tmp/build/backend/requirements.txt ./requirements.txt; \
      cp -r /tmp/build/backend/. ./; \
    else \
      cp /tmp/build/requirements.txt ./requirements.txt; \
      cp -r /tmp/build/. ./; \
    fi \
    && rm -rf /tmp/build \
    && pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

# Coleta arquivos estáticos
RUN python manage.py collectstatic --noinput || true

EXPOSE 7860 8080 8000

# Executa Gunicorn com Uvicorn workers suportando $PORT injetada pelo Railway (ou 8000/7860/8080 por padrão)
# Nota: Sem HEALTHCHECK interno periódico de 30s para não gerar tráfego em localhost que impeça o sleep do container.
# O Railway valida a saúde externamente pelo proxy durante o rollout na porta configurada.
CMD ["sh", "-c", "BIND_PORT=\"${PORT:-8000}\"; exec gunicorn app.asgi:application -w ${WORKERS:-1} -k uvicorn.workers.UvicornWorker -b 0.0.0.0:${BIND_PORT} --forwarded-allow-ips '*' --timeout 120 --graceful-timeout 30 --access-logfile -"]
