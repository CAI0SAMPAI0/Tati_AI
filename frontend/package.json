{
  "name": "tati-ai-frontend",
  "version": "2.1.1",
  "private": true,
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "sync-assets": "node -e \"const fs=require('fs');const path=require('path');const src=path.join(process.cwd(),'../backend/assets/images/tati_logo.jpg');const dest=path.join(process.cwd(),'public/images/tati_logo.jpg');if(fs.existsSync(src)){fs.mkdirSync(path.dirname(dest),{recursive:true});fs.copyFileSync(src,dest);}else{console.warn('tati_logo.jpg not found in backend, skipping sync');}\"",
    "dev": "npm run sync-assets && next dev --port 3000",
    "dev:clean": "npm run clean && next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.3.4",
    "@capacitor/push-notifications": "^8.1.1",
    "@tanstack/react-query": "^5.101.0",
    "@vercel/speed-insights": "^2.0.0",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.468.0",
    "next": "14.2.29",
    "next-themes": "^0.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^5.6.0",
    "react-markdown": "9.0.3",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "swr": "^2.2.5",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.29",
    "postcss": "^8",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions",
    "not dead",
    "not IE 11"
  ]
}
