# ==============================================================================
# Tati AI - Frontend Vue Production Environment Variables
# ==============================================================================
# In Vite / Vue, all client-exposed environment variables MUST start with VITE_
# (differing from Next.js which used NEXT_PUBLIC_).
#
# Replace the placeholder values with your production domains and keys.
# ==============================================================================

# Backend API Base URL (Django REST API backend)
# Example: https://api.tatiai.com or https://backend-production.up.railway.app
# In dev: http://localhost:8000
VITE_API_BASE_URL=https://api.tatiai.com

# Backend WebSocket Base URL (Voice mode, real-time chat, notifications)
# Example: wss://api.tatiai.com or wss://backend-production.up.railway.app
# In dev: ws://localhost:8000
VITE_WS_BASE_URL=wss://api.tatiai.com

# External Hub / Storefront URL
# Example: https://hub.tatiai.com
VITE_HUB_SITE_URL=https://hub.tatiai.com

# Google OAuth 2.0 Client ID (for Google Sign-In)
# Example: 123456789-abcdef.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=

# Supabase Storage & Database URL (optional, for direct CDN material assets)
# Example: https://xyzcompany.supabase.co
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_STORAGE_URL=

# Support Contact Email
# Example: contato@tatiai.com
VITE_SUPPORT_EMAIL=contato@tatiai.com

# Sentry Telemetry & Error Tracking (optional)
# Example: https://xxxxxxxx@o000000.ingest.sentry.io/0000000
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production

# Feature Flags
# Allow all users to access trimestral exams (default: true)
VITE_EXAMS_FOR_ALL=true
